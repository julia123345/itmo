        <!-- ===================== LEGEND ===================== -->
        <mxCell id="legend" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#9632; синий — память&lt;br&gt;&amp;#9632; зелёный — регистры&lt;br&gt;&amp;#9632; фиолетовый — стеки&lt;br&gt;&amp;#9632; красный — ALU&lt;br&gt;&amp;#9632; оранжевый — control unit&lt;br&gt;&lt;br&gt;— синяя толстая = шина данных&lt;br&gt;- - оранжевая = управление&lt;br&gt;— тёмная = тракт данных" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1010" y="70" width="200" height="172" as="geometry" />
        </mxCell>

        <!-- ===================== CYCLE NOTE ===================== -->
        <mxCell id="cycle_info" value="&lt;b&gt;ЦИКЛ ВЫПОЛНЕНИЯ (асинхронный, без тактовой частоты):&lt;/b&gt;&lt;br&gt;&lt;br&gt;①&amp;nbsp;&lt;b&gt;Fetch:&lt;/b&gt; при исполнении из RAM слово mem[P] → I, затем P++. Через порт P НЕ инкрементируется.&lt;br&gt;②&amp;nbsp;&lt;b&gt;Slot-execute:&lt;/b&gt; 18-битное слово I исполняется послотно — 4 слота (5+5+5+3 бит).&lt;br&gt;③&amp;nbsp;&lt;b&gt;ALU:&lt;/b&gt; операции безадресные, операнды с вершины стека (T, S), результат → T.&lt;br&gt;④&amp;nbsp;&lt;b&gt;Данные:&lt;/b&gt; адрес из P / A / B → MUX → address bus; @ читает в T, ! пишет T в память.&lt;br&gt;⑤&amp;nbsp;&lt;b&gt;Переходы:&lt;/b&gt; jump/call/next/if/-if заменяют младшие биты P (в пределах «страницы»).&lt;br&gt;⑥&amp;nbsp;&lt;b&gt;Стек R:&lt;/b&gt; call → P→R; ; (return) → R→P; next/unext используют R как счётчик до 0." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="910" width="660" height="200" as="geometry" />
        </mxCell>

        <!-- ===================== ISA REFERENCE ===================== -->
        <mxCell id="isa" value="&lt;b&gt;СИСТЕМА КОМАНД F18A — 32 опкода (5 бит)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Управление (8):&lt;/b&gt;&amp;nbsp; ;&amp;nbsp;(ret)&amp;nbsp;·&amp;nbsp; ex&amp;nbsp;·&amp;nbsp; jump&amp;nbsp;·&amp;nbsp; call&amp;nbsp;·&amp;nbsp; next&amp;nbsp;·&amp;nbsp; unext&amp;nbsp;·&amp;nbsp; if&amp;nbsp;(T=0)&amp;nbsp;·&amp;nbsp; -if&amp;nbsp;(T≥0)&lt;br&gt;&lt;br&gt;&lt;b&gt;Память (8):&lt;/b&gt;&amp;nbsp; @p&amp;nbsp;·&amp;nbsp; @+&amp;nbsp;·&amp;nbsp; @b&amp;nbsp;·&amp;nbsp; @&amp;nbsp;·&amp;nbsp; !p&amp;nbsp;·&amp;nbsp; !+&amp;nbsp;·&amp;nbsp; !b&amp;nbsp;·&amp;nbsp; !&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#777777&quot;&gt;(p и + дают авто-инкремент)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ALU / стек (16):&lt;/b&gt;&amp;nbsp; +&amp;nbsp;·&amp;nbsp; - &lt;font color=&quot;#b85450&quot;&gt;(инверсия, НЕ вычитание)&lt;/font&gt;&amp;nbsp;·&amp;nbsp; and&amp;nbsp;·&amp;nbsp; or&amp;nbsp;&lt;font color=&quot;#b85450&quot;&gt;(= XOR!)&lt;/font&gt;&amp;nbsp;·&amp;nbsp; 2*&amp;nbsp;(сдвиг ←)&amp;nbsp;·&amp;nbsp; 2/&amp;nbsp;(сдвиг →)&amp;nbsp;·&amp;nbsp; +*&amp;nbsp;(шаг умн.)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; dup&amp;nbsp;·&amp;nbsp; drop&amp;nbsp;·&amp;nbsp; over&amp;nbsp;·&amp;nbsp; push&amp;nbsp;(T→R)&amp;nbsp;·&amp;nbsp; pop&amp;nbsp;(R→T)&amp;nbsp;·&amp;nbsp; a&amp;nbsp;(A→T)&amp;nbsp;·&amp;nbsp; a!&amp;nbsp;·&amp;nbsp; b!&amp;nbsp;·&amp;nbsp; .&amp;nbsp;(nop)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;Внимание:&lt;/b&gt;&lt;/font&gt; нет swap; нет вычитания (через inv+1); &lt;b&gt;or&lt;/b&gt; = XOR; &lt;b&gt;-&lt;/b&gt; = инверсия; B только на запись; доступ к памяти только через P/A/B." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="820" width="700" height="290" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
